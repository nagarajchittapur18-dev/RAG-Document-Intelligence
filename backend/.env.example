# ====================================================================
# DocuRAG / RAGMate - Backend Environment Configuration Template
# ====================================================================

ENVIRONMENT=production

# Database
DATABASE_URL=sqlite:///./ragmate.db
# DATABASE_URL=postgresql+psycopg://postgres_user:strong_password@ep-xyz.region.neon.tech/docurag?sslmode=require

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Authentication & Security
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & Domains
FRONTEND_URL=https://docurag.vercel.app
BACKEND_URL=https://docurag-api.onrender.com
CORS_ORIGINS=https://docurag.vercel.app,http://localhost:5173,http://localhost:3000

# ChromaDB Vector Store
CHROMA_PERSIST_DIRECTORY=./chroma_data
# CHROMA_HOST=
# CHROMA_PORT=8000
# CHROMA_SSL=false
# CHROMA_AUTH_TOKEN=

# Dense Embeddings & Cross-Encoder Reranker
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_ENABLED=true
RERANKING_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=15
RERANKING_TOP_K=5
MAX_RERANK_TEXT_LENGTH=1000

# Document & Object Storage
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE_MB=25
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=docurag-pdf-documents
# STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=your_s3_or_r2_access_key
# STORAGE_SECRET_KEY=your_s3_or_r2_secret_key
