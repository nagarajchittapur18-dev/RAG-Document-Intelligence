# ====================================================================
# RAGMate - Intelligent Document QA System Configuration
# ====================================================================

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (Async SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./ragmate.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragmate

# Authentication & Security
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Embedding Model (HuggingFace Sentence Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG & Chunking Parameters
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SIMILARITY_THRESHOLD=0.35

# Reranking Configuration
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Uploads Configuration
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE_MB=25

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
