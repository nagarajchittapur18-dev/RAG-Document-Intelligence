# ====================================================================
# DocuRAG / RAGMate - Master Production Environment Configuration
# ====================================================================

# Application Environment Mode ("development" | "production" | "testing")
ENVIRONMENT=production

# --------------------------------------------------------------------
# 1. Relational Database Connection
# --------------------------------------------------------------------
# Default SQLite (for local development, container volume, or testing):
DATABASE_URL=sqlite:///./ragmate.db
# Managed PostgreSQL (Neon, Supabase, Render, Railway, AWS RDS):
# DATABASE_URL=postgresql+psycopg://postgres_user:strong_password@ep-xyz.region.neon.tech/docurag?sslmode=require

# --------------------------------------------------------------------
# 2. Large Language Model (Google Gemini)
# --------------------------------------------------------------------
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# --------------------------------------------------------------------
# 3. Security & Authentication (JWT & Password Hashing)
# --------------------------------------------------------------------
# Generate a secure 32+ char key using: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------------------------------
# 4. Networking, Cloud Domains & CORS
# --------------------------------------------------------------------
FRONTEND_URL=https://docurag.vercel.app
BACKEND_URL=https://docurag-api.onrender.com
# Allowed origins for CORS (comma-separated):
CORS_ORIGINS=https://docurag.vercel.app,http://localhost:5173,http://localhost:3000

# --------------------------------------------------------------------
# 5. Vector Database (ChromaDB)
# --------------------------------------------------------------------
# Local persistent Chroma volume:
CHROMA_PERSIST_DIRECTORY=./chroma_data
# Remote Chroma Server (e.g. Chroma Cloud or dedicated container):
# CHROMA_HOST=
# CHROMA_PORT=8000
# CHROMA_SSL=false
# CHROMA_AUTH_TOKEN=

# --------------------------------------------------------------------
# 6. Dense Embeddings & Reranker Models
# --------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_ENABLED=true
RERANKING_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=15
RERANKING_TOP_K=5
MAX_RERANK_TEXT_LENGTH=1000

# --------------------------------------------------------------------
# 7. Document & File Storage
# --------------------------------------------------------------------
# Storage provider: "local" (persistent volume / disk) or "s3" (AWS S3, Cloudflare R2, Supabase)
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE_MB=25

# S3-Compatible Cloud Object Storage Configuration:
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=docurag-pdf-documents
# STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=your_s3_or_r2_access_key
# STORAGE_SECRET_KEY=your_s3_or_r2_secret_key

# --------------------------------------------------------------------
# 8. Frontend Environment Variables (Vite)
# --------------------------------------------------------------------
VITE_API_BASE_URL=https://docurag-api.onrender.com/api
