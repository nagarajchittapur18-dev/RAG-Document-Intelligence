# ====================================================================
# DocuRAG / RAGMate - Master Environment Configuration Template
# ====================================================================

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Backend Relational Database URL
DATABASE_URL=sqlite+aiosqlite:///./ragmate.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ragmate

# Security & Authentication (JWT)
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vector Store (ChromaDB Persistence)
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Local Dense Pretrained Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking & RAG Retrieval Hyperparameters
TOP_K=5
INITIAL_TOP_K=15
FINAL_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SIMILARITY_THRESHOLD=0.15
MAX_CONTEXT_CHARS=12000
ENABLE_DOCUMENT_BALANCING=true
CHAT_HISTORY_LIMIT=10

# Neural Cross-Encoder Reranker Options
RERANKER_ENABLED=true
RERANKING_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKING_CANDIDATES=15
RERANKING_TOP_K=5
MAX_RERANK_TEXT_LENGTH=1000

# File Storage & Upload Constraints
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE_MB=25

# Production CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
